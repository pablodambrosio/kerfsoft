{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "start",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Available on:"
                }
            },
            "label": "npm: start"
        },
        {
            "type": "npm",
            "script": "build_website_dev",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "npm: build_website_dev"
        },
        {
            "type": "npm",
            "script": "build_engine_dev",
            "group": "build",
            "label": "npm: build_engine_dev"
        },
        {
            "type": "npm",
            "script": "lint",
            "group": "build",
            "label": "npm: lint"
        }
    ]
}
